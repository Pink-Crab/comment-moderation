# WP-PHPUnit database credentials for local development.
#
# Copy this file to `.env` (alongside this one) and fill in your own values.
# `tests/.env` is gitignored — never commit DB credentials. CI overrides
# these by setting the same env vars directly in the workflow.
#
# The database MUST exist before running the tests. wp-phpunit will DROP
# ALL TABLES with the `WP_TESTS_TABLE_PREFIX` prefix, so use a dedicated
# test database — never a production or shared one.

WP_DB_NAME=wordpress_test
WP_DB_USER=root
WP_DB_PASS=
WP_DB_HOST=127.0.0.1

# Optional. Defaults to `wptests_`.
# WP_TESTS_TABLE_PREFIX=wptests_
