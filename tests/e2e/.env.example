# Copy this file to tests/e2e/.env and adjust as needed.

# WordPress base URL — defaults to the wp-env dev port (57881).
WP_BASE_URL=http://localhost:57881

# Admin credentials used by tests/e2e/global-setup.js to log in once and
# persist the session to tests/e2e/.auth/admin.json. wp-env's defaults
# are "admin" / "password".
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password
