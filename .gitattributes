# Normalise line endings.
* text=auto eol=lf

# PHP, JS, CSS, SCSS — text.
*.php       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.neon      text eol=lf

# Files excluded from release zip / `git archive` (also drives composer
# build, which uses git archive as its single source of truth for what
# ships — see scripts/build.sh). If you add a dev-only file to the
# scaffold, add it here too or it will leak into dist/.
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.github/               export-ignore
/.phpcs.xml             export-ignore
/.phpmd.xml             export-ignore
/.phpstan.neon          export-ignore
/.php-scoper.inc.php    export-ignore
/.scaffold/             export-ignore
/phpunit.xml.dist       export-ignore
/scripts/               export-ignore
/tests/                 export-ignore
/type-defs.php          export-ignore
/assets/src/            export-ignore
/postcss.config.js      export-ignore
/jsconfig.json          export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
# Test WordPress install (roots/wordpress-core-installer puts WP here for
# wp-phpunit, NOT in vendor/). Git ignores it (.gitignore), but git archive /
# composer archive only honour export-ignore — without this line WP leaks into dist/.
/wordpress/             export-ignore
